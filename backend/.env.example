# OLIVER 3.0 Central Backend Configuration
PROJECT_NAME="OLIVER Backend"
ENVIRONMENT="development"
DEBUG=true

# Server Network
HOST="127.0.0.1"
PORT=8000

# Security (JWT & Token Hashing)
# Generate secure secret via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change_this_to_a_secure_random_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — SQLite (local development default)
# Used when PostgreSQL is not configured. Auto-DDL enabled for oliver_dev.db in development mode.
DATABASE_URL="sqlite:///./backend/oliver_dev.db"

# Database — PostgreSQL (Docker local development)
# FastAPI runs on Windows host; PostgreSQL runs in Docker with port 5432 exposed to localhost.
# Uncomment and populate the section below when switching to PostgreSQL (Stage 2.1A.4+).
# Replace <password> with the value you set in your Docker provisioning scripts.
# NEVER commit a file containing real passwords to Git.
#
# DATABASE_URL="postgresql+psycopg://oliver_app_user:<password>@localhost:5432/oliver_db"
#
# PostgreSQL connection details (used by Docker Compose and provisioning scripts)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=oliver_db
# POSTGRES_USER=oliver_app_user
# POSTGRES_PASSWORD=<change_to_secure_password>
#
# PostgreSQL test database (Category B testing only — separate from application DB)
# POSTGRES_TEST_DB=oliver_test
# POSTGRES_TEST_USER=oliver_test_user
# POSTGRES_TEST_PASSWORD=<change_to_secure_test_password>

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# AI Inference (Ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT=120.0

# Rate Limiting
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_CHAT="30/minute"

