# OLIVER 3.0 Central Backend Configuration
PROJECT_NAME="OLIVER Backend"
ENVIRONMENT="development"
DEBUG=true

# Server Network
HOST="127.0.0.1"
PORT=8000

# Security (JWT & Token Hashing)
# Generate secure secret via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change_this_to_a_secure_random_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite dev default; PostgreSQL for production)
DATABASE_URL="sqlite:///./backend/oliver_dev.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# AI Inference (Ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT=120.0

# Rate Limiting
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_CHAT="30/minute"

