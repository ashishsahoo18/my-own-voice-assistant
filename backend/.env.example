# OLIVER 3.0 Central Backend Configuration
PROJECT_NAME="OLIVER Backend"
ENVIRONMENT="development"
DEBUG=true

# Server Network
HOST="127.0.0.1"
PORT=8000

# Security (JWT & Token Hashing)
# Generate secure secret via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change_this_to_a_secure_random_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — SQLite (local development default)
# Used when PostgreSQL is not configured. Auto-DDL enabled for oliver_dev.db in development mode.
DATABASE_URL="sqlite:///./backend/oliver_dev.db"

# ==============================================================================
# Database — PostgreSQL (Docker local development — Stage 2.1A.4+)
# ==============================================================================
# FastAPI runs on Windows host; PostgreSQL runs in Docker with port 5432 exposed to localhost.
# Copy this file to backend/.env and customize passwords. Actual credentials belong
# strictly in backend/.env which is ignored by Git. NEVER commit real credentials.
#
# 1. Application Runtime Connection (DML only — oliver_app_user):
# DATABASE_URL="postgresql+psycopg://oliver_app_user:<secure_app_password>@localhost:5432/oliver_db"
#
# 2. Migration Connection (DDL & Schema Owner — oliver_migrator — used exclusively by Alembic):
# MIGRATION_DATABASE_URL="postgresql+psycopg://oliver_migrator:<secure_migrator_password>@localhost:5432/oliver_db"
#
# 3. Docker PostgreSQL Cluster Provisioning Passwords (enforces >= 16 characters):
# POSTGRES_ADMIN_USER="postgres"
# POSTGRES_ADMIN_PASSWORD="change_me_to_at_least_16_characters_admin"
# POSTGRES_MIGRATOR_PASSWORD="change_me_to_at_least_16_characters_migrator"
# POSTGRES_APP_PASSWORD="change_me_to_at_least_16_characters_app"
# POSTGRES_TEST_PASSWORD="change_me_to_at_least_16_characters_test"
#
# 4. PostgreSQL Connection Metadata (for Docker Compose and provisioning scripts):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=oliver_db
# POSTGRES_USER=oliver_app_user
#
# 5. Category B Pytest Connection (Test isolation — oliver_test_user):
# POSTGRES_TEST_DB=oliver_test
# POSTGRES_TEST_USER=oliver_test_user
# Set OLIVER_TEST_MODE=category_b and DATABASE_URL before running pytest:
# DATABASE_URL="postgresql+psycopg://oliver_test_user:<secure_test_password>@127.0.0.1:5432/oliver_test"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# AI Inference (Ollama)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT=120.0

# Rate Limiting
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_CHAT="30/minute"
